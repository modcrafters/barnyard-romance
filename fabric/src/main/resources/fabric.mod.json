{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.modcrafters.minecraft.barnyardromance.fabric.BarnyardRomanceFabric"
        ],
        "client": [
            "net.modcrafters.minecraft.barnyardromance.fabric.client.BarnyardRomanceFabricClient"
        ],
        "fabric-gametest": [
            "net.modcrafters.minecraft.barnyardromance.fabric.gametest.FabricBreedingGameTests",
            "net.modcrafters.minecraft.barnyardromance.fabric.gametest.FabricFoodGameTests",
            "net.modcrafters.minecraft.barnyardromance.fabric.gametest.FabricProductGameTests",
            "net.modcrafters.minecraft.barnyardromance.fabric.gametest.FabricHerdBookGameTests",
            "net.modcrafters.minecraft.barnyardromance.fabric.gametest.FabricCareGameTests",
            "net.modcrafters.minecraft.barnyardromance.fabric.gametest.FabricEggGameTests"
        ],
        "fabric-client-gametest": [
            "net.modcrafters.minecraft.barnyardromance.fabric.gametest.InspectorClientGameTest",
            "net.modcrafters.minecraft.barnyardromance.fabric.gametest.LooksClientGameTest",
            "net.modcrafters.minecraft.barnyardromance.fabric.gametest.HerdBookClientGameTest"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    }
}
